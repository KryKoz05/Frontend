pipeline {
    agent { label 'python' }
    triggers {
        pollSCM('H/2 * * * *')
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
    }

    stages {
        stage('Install dependencies') {
            steps {
                sh '''
                    python3 --version
                    python3 -m venv --clear .venv
                    .venv/bin/python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Tests') {
            steps {
                sh '''
                    mkdir -p test-results
                    .venv/bin/python -m pytest -v test_app.py \
                        --junitxml=test-results/pytest.xml
                '''
            }
            post {
                always {
                    junit 'test-results/pytest.xml'
                }
            }
        }
        stage('Build image') {
            steps {
                sh 'docker build -t portfolio-frontend:ci-${BUILD_NUMBER} .'
            }
        }

        stage('Test image') {
            steps {
                sh '''
                    docker run --rm \
                        portfolio-frontend:ci-${BUILD_NUMBER} \
                        python -m pytest -v test_app.py
                '''
            }
        }
        stage('Publish image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        set -eu

                        DOCKER_CONFIG=$(mktemp -d)
                        export DOCKER_CONFIG
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                        printf '%s' "$DOCKERHUB_TOKEN" |
                            docker login \
                                --username "$DOCKERHUB_USER" \
                                --password-stdin

                        docker tag \
                            "portfolio-frontend:ci-${BUILD_NUMBER}" \
                            "krykoz05/portfolio-frontend:ci-${BUILD_NUMBER}"

                        docker push \
                            "krykoz05/portfolio-frontend:ci-${BUILD_NUMBER}"
                    '''
                }
            }
        }
    }
}
