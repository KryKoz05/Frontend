pipeline {
    agent { label 'python' }
    triggers {
        pollSCM('H/2 * * * *')
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
    }

    stages {
        stage('Install dependencies') {
            steps {
                sh '''
                    python3 --version
                    python3 -m venv --clear .venv
                    .venv/bin/python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Tests') {
            steps {
                sh '''
                    mkdir -p test-results
                    .venv/bin/python -m pytest -v test_app.py \
                        --junitxml=test-results/pytest.xml
                '''
            }
            post {
                always {
                    junit 'test-results/pytest.xml'
                }
            }
        }
        stage('Build image') {
            steps {
                sh 'docker build -t portfolio-frontend:ci-${BUILD_NUMBER} .'
            }
        }

        stage('Test image') {
            steps {
                sh '''
                    docker run --rm \
                        portfolio-frontend:ci-${BUILD_NUMBER} \
                        python -m pytest -v test_app.py
                '''
            }
        }
    }
}
